# Copy to backend/.env (do not commit real keys).

# Used by image description and content summarization (Vision regions).
OPENAI_API_KEY=

# Optional OpenAI Vision fallback for difficult title / image-description cases.
# Main PP2 research mode is local-only. Keep this false unless needed.
USE_OPENAI_FALLBACK=false

# Local image description model for /abhishek/analyze.
# blip = Salesforce/blip-image-captioning-base (default)
# florence = microsoft/Florence-2-base-ft (optional; falls back to BLIP on failure)
IMAGE_DESCRIPTION_MODEL=blip

# Title OCR model for /abhishek/analyze.
# easyocr = existing EasyOCR title reader (default)
# paddleocr = PaddleOCR first, then EasyOCR fallback if Paddle fails
TITLE_READER_MODEL=easyocr

# Optional: Tesseract executable if not on PATH (Windows example).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: override category model path (default: model/category_model.pkl).
# CATEGORY_MODEL_PATH=

# Optional: Ollama model for reconstruction and summaries.
# LLAMA_MODEL=llama3.2:3b

# Clean full-text OCR with local Ollama Llama (same as summary path).
# CLEAN_FULL_TEXT_WITH_LLAMA=true
# LLAMA_MODEL=llama3.2:3b