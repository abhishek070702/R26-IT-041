# Copy to .env and fill in values. Never commit .env.

# Required for Newspaper/Magazine region detection (Vision API).
OPENAI_API_KEY=

# Optional: full path to tesseract.exe if not on PATH (Windows example below).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: path to category_model.pkl (default is next to pipeline.py).
# CATEGORY_MODEL_PATH=

# Optional: Ollama model for reconstruction/summary (default llama3.2:3b).
# LLAMA_MODEL=llama3.2:3b

# Optional: CORS for the React dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: API port.
# PORT=8000

# V7 pipeline switches
# RESEARCH_MODE=false
# ENABLE_OPENAI_FALLBACK=true
# ENABLE_OPENAI_CATEGORY_FALLBACK=true
# ENABLE_OPENAI_SUMMARY_FALLBACK=true
# AI article detection first (Newspaper/Magazine). Set false to use local-first.
# PREFER_OPENAI_ARTICLE_DETECTION_FIRST=true
